# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration (Gmail with App Password)
# 1. Enable 2FA on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" and "Windows Computer"
# 4. Copy the generated 16-character password below

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Email Receiving Configuration
EMAIL_TO=your-email@gmail.com
DEPLOYMENT_NOTIFY_EMAIL=your-email@gmail.com

# CORS Origins
CORS_ORIGIN=http://localhost:3000

# Deployment Configuration (optional)
DEPLOYED_URL=http://localhost:3000
DEPLOYMENT_ENVIRONMENT=development
